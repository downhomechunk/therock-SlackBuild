#!/bin/sh

# Slackware build script for TheRock

# Copyright 2026, James Halloran, Chicago
# All rights reserved.
#
# Redistribution and use of this script, with or without modification, is
# permitted provided that the following conditions are met:
#
# 1. Redistributions of this script must retain the above copyright
#    notice, this list of conditions and the following disclaimer.
#
#  THIS SOFTWARE IS PROVIDED BY THE AUTHOR "AS IS" AND ANY EXPRESS OR IMPLIED
#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
#
# NOTE: This script REQUIRES NETWORK ACCESS while running. TheRock
# downloads component sources, toolchains, and dependency archives from
# the internet at build time. Sources are cached persistently in
# $SRC_CACHE so subsequent builds only fetch deltas. Do NOT run this on
# air-gapped or restricted machines. See README for details.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=therock
SRCNAME=TheRock
VERSION=${VERSION:-10.1}
BUILD=${BUILD:-3}
TAG=${TAG:-_dhc}	# change to _SBo if accepted by the slackbuild team
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

# Persistent source cache: survives builds so we fetch deltas, not the
# world. /var/cache is the FHS location for regenerable persistent data;
# fully reclaimable with 'rm -rf /var/cache/therock'.
SRC_CACHE=${SRC_CACHE:-/var/cache/therock}

# Parallelism: JOBS controls the outer build graph (-j) AND, via
# CMAKE_BUILD_PARALLEL_LEVEL, the inner per-subproject cmake --build
# invocations, which otherwise default to all cores regardless of -j.
JOBS=${JOBS:-8}
NUMJOBS=" -j $JOBS "
export CMAKE_BUILD_PARALLEL_LEVEL=$JOBS

# Default GPU family is gfx120X-all (RDNA4: gfx1200 + gfx1201, covering the
# RX 9060 series, RX 9070 series, and Radeon AI PRO R9700). Choose
# exact targets for leaner builds.
GPU_FAMILIES=${GPU_FAMILIES:-gfx120X-all}

# Optional ccache acceleration: Opt-in, off unless asked for.
use_ccache="" ; [ "${USE_CCACHE:-no}" != "no" ] && use_ccache="yes"

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e
umask 022

# ---------------------------------------------------------------------------
# Sanity checks -- fail loud and early, not 40 hours into a build.
# ---------------------------------------------------------------------------
sanity_fail() {
  echo "*** ERROR: required tool '$1' not found in PATH." >&2
  echo "***        Install it (current tree or SBo) and rerun." >&2
  exit 1
}

for tool in cmake ninja git git-lfs patchelf python3 ctest; do
  command -v "$tool" >/dev/null 2>&1 || sanity_fail "$tool"
done

# ccache: accelerator, not a dependency. Warn and continue without it.
if [ "$use_ccache" = "yes" ] && ! command -v ccache >/dev/null 2>&1 ; then
  echo "*** WARNING: USE_CCACHE set but ccache not found in PATH." >&2
  echo "***          Building without ccache." >&2
  sleep 3
  use_ccache=""
fi

ccache_launcher=""
if [ "$use_ccache" = "yes" ]; then
  # BASEDIR/NOHASHDIR/SLOPPINESS are load-bearing: TheRock's fetched clang
  # lives at paths inside $SRC_CACHE/$TMP, and without these ccache treats
  # every differing absolute path as a new compile and never hits.
  export CCACHE_DIR=$SRC_CACHE/ccache
  export CCACHE_BASEDIR=$SRC_CACHE
  export CCACHE_NOHASHDIR=true
  export CCACHE_SLOPPINESS="include_file_ctime,include_file_mtime,file_macro,time_macros"
  ccache_launcher="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache"
  echo "=> ccache enabled (cache: $CCACHE_DIR)"
fi

echo "=> Target GPU families: $GPU_FAMILIES"
echo "=> Persistent source cache: $SRC_CACHE"
echo "=> This script WILL contact the internet to fetch sources."

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT $SRC_CACHE

# ---------------------------------------------------------------------------
# Source: the TheRock tag tarball is only the launcher; the build system
# fetches the actual component trees itself, into a persistent workdir.
# On reruns, the cached tree is reused (fetch_sources.py will sync deltas),
# so we only extract+migrate on a cold cache.
# ---------------------------------------------------------------------------

if [ ! -d $SRC_CACHE/therock-$VERSION ]; then
  cd $TMP
  rm -rf $SRCNAME-$PRGNAM-$VERSION
  # NOTE: tarball name is taken verbatim from GitHub's tag archive naming
  # (repo 'TheRock', tag 'therock-X.Y'); do not rename before extracting.
  tar xvf $CWD/$SRCNAME-$PRGNAM-$VERSION.tar.gz --no-same-owner
  cd $SRCNAME-$PRGNAM-$VERSION
  # fetch_sources.py drives `git submodule update` on the root repo,
  # which requires a real git checkout: a tag tarball has no .git.
  # Graft git metadata by fetching the matching tag (shallow) and
  # resetting the tree to it, so submodules resolve.
  git init
  git remote add origin https://github.com/ROCm/TheRock.git
  git fetch --depth 1 origin "refs/tags/therock-$VERSION:refs/tags/therock-$VERSION"
  git reset --hard therock-$VERSION
  cd $TMP
  mv $SRCNAME-$PRGNAM-$VERSION $SRC_CACHE/therock-$VERSION

else
  echo "=> Reusing cached tree: $SRC_CACHE/therock-$VERSION"
  if [ -f "$SRC_CACHE/therock-$VERSION/version.json" ]; then
    echo "=> Payload version reported by tree:"
    grep -E 'rocm-version' "$SRC_CACHE/therock-$VERSION/version.json"
  fi
fi
cd $SRC_CACHE/therock-$VERSION

# Reuse a venv across builds (it lives in the cache, not on the system).
# Pip installs from the tree's own requirements.txt so pins always match
# the tag being built -- never point pip at main.
unset PYTHONPATH
export PYTHONNOUSERSITE=1   # blind ~/.local pickups for this build
if [ ! -x ".venv/bin/python" ]; then
  python3 -m venv .venv
fi
# shellcheck disable=SC1091
. .venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt

if [ -d "$SRC_CACHE/therock-$VERSION/rocm-systems/.git" ]; then
  _tree="$SRC_CACHE/therock-$VERSION/rocm-systems"
  # TheRock's fetch layer arms skip-worktree bits on managed files,
  # which blinds git status AND makes checkout a silent no-op. Clear
  # them first, or the revert+check below will lie about tree state.
  git -C "$_tree" ls-files -v | grep '^[a-z]' | cut -c3- | \
    xargs -r git -C "$_tree" update-index --no-skip-worktree
  git -C "$_tree" checkout -- .
  if [ -n "$(git -C "$_tree" status --porcelain)" ]; then
    echo "*** ERROR: cached rocm-systems diverges from tag $VERSION" >&2
    echo "***        in ways checkout cannot repair (untracked files?):" >&2
    git -C "$_tree" status --porcelain >&2
    echo "*** Refusing to build. Remove the tree to refetch:" >&2
    echo "***   rm -rf $SRC_CACHE/therock-$VERSION/rocm-systems" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Fetch/sync TheRock component sources (amd-llvm, rocm-libraries,
# rocm-systems, ...) into the tree. This is the heavy network phase;
# the persistent cache makes re-runs delta-only.
# ---------------------------------------------------------------------------
python build_tools/fetch_sources.py

# Apply patch scripts. Idempotency is each script's responsibility
# (guard + verify + die-loudly pattern -- see individual scripts).
# Routing convention: script filename suffix names the target tree
# (e.g. *.rocm-systems.sh -> $SRC_CACHE/therock-$VERSION/rocm-systems),
# but scripts self-route via hardcoded _root today; suffix is
# documentation until a shared dispatcher exists.
export SRC_CACHE VERSION
for _p in $CWD/patches/*.sh; do
  echo "=> Applying $(basename $_p)"
  sh "$_p"
done

# rocm-systems#12596: HIP host_defines.h defines __noinline__ as an empty
# macro for host compilers; libstdc++ 16 uses it as an attribute name
# ([[__gnu__::__noinline__]]), breaking <format>/<chrono>. Delete the empty
# host-side define from ALL copies, including build-tree copies a warm
# cache already contains (a source patch alone won't fix staged headers;
# this is why this fix is a sed and not a patch file).
for f in $(find "$SRC_CACHE/therock-$VERSION" -name host_defines.h -path '*amd_detail*'); do
  if grep -q '^#define __noinline__$' "$f"; then
    sed -i '/^#define __noinline__$/d' "$f"
  fi
done

# Assertion: if the bare define survived the sweep, stop -- a hipfile
# build that proceeds past this point will fail with a confusing
# 'expected identifier' in <format> that points at libstdc++, not at us.
if grep -rq '^#define __noinline__$' --include=host_defines.h \
     "$SRC_CACHE/therock-$VERSION" ; then
  echo "*** ERROR: bare __noinline__ define survived patching." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Configure
# Note: SLKCFLAGS/CMAKE_*_FLAGS_RELEASE overrides are deliberately not used.
# TheRock is a CMake superbuild controlling dozens of sub-projects; forcing
# global optimization flags risks perturbing ROCm math libraries that
# assert their own flag recipes. The superbuild owns its own flags.
# ---------------------------------------------------------------------------

cmake -B build -GNinja \
  -DCMAKE_BUILD_TYPE=Release \
  -DTHEROCK_AMDGPU_FAMILIES="$GPU_FAMILIES" \
  -DTHEROCK_AMDGPU_DIST_BUNDLE_NAME="$(echo "$GPU_FAMILIES" | tr ';' '-')" \
  -DTHEROCK_BUILD_TESTING=OFF \
  -DTHEROCK_ENABLE_EMULATION=OFF \
  -DTHEROCK_ENABLE_ROCJITSU_HOTSWAP=OFF \
  -DFLANG_PARALLEL_COMPILE_JOBS=${FLANG_JOBS:-4} \
  -DLLVM_PARALLEL_LINK_JOBS=${LINK_JOBS:-1} \
  $ccache_launcher

# ---------------------------------------------------------------------------
# Build: therock-dist produces the relocatable distribution
# ---------------------------------------------------------------------------
cmake --build build --target therock-dist $NUMJOBS

if [ ! -d build/dist ]; then
  echo "*** ERROR: build/dist missing after build; something went wrong." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Stage into package root: TheRock dist is self-contained -> /opt/rocm
# (matching upstream convention and AMD's own install location)
# ---------------------------------------------------------------------------
_dist_root="$PWD/build/dist/rocm"
mkdir -p $PKG/opt/rocm
cp -a build/dist/rocm/. $PKG/opt/rocm/

# Verify staging fidelity: $PKG/opt/rocm must be an exact copy of the dist
# (run BEFORE the perm/gzip normalization blocks, which mutate the tree)
_manifest() { find . \( -type f -o -type l \) -printf '%y %p -> %l\n' | sort; }
( cd "$_dist_root"            && _manifest ) > "$TMP/dist.manifest"
( cd "$PKG/opt/rocm"          && _manifest ) > "$TMP/pkg.manifest"
if ! cmp -s "$TMP/dist.manifest" "$TMP/pkg.manifest"; then
  echo "*** ERROR: staged payload differs from dist:" >&2
  diff "$TMP/dist.manifest" "$TMP/pkg.manifest" | head -30 >&2
  exit 1
fi

# Ownership and permissions. No strip pass: ROCm dists ship prebuilt
# objects and .kpacks the build system produced itself; stripping files
# we did not compile risks corrupting runtime artifacts. Deliberate
# divergence from the template.
chown -R root:root $PKG
find $PKG -type d -exec chmod 755 {} \;

# Normalize file permissions without guessing what AMD intended to be
# executable: preserve the exec bit where the build system set it, and
# demote only non-executable writable files. The blanket 644 pass the
# template uses would flatten shebang'd helper scripts living outside
# bin/ (libexec helpers, *.py wrappers invoked by path).
find $PKG -type f -perm /111 -exec chmod 755 {} \;
find $PKG -type f ! -perm /111 -exec chmod 644 {} \;

_bin="$PKG/opt/rocm/bin"
[ -d "$_bin" ] || { echo "*** ERROR: no bin/ in staged /opt/rocm" >&2; exit 1; }

find "$_bin" -maxdepth 1 -type f ! -perm -u+x \
  \( -name '*.sh' -o -name 'hipcc*' -o -name 'amdclang*' \) \
  -exec chmod 755 {} +

# Compress man pages if the dist shipped any (under its own prefix)
if [ -d $PKG/opt/rocm/man ]; then
  find $PKG/opt/rocm/man -type f -exec gzip -9 {} \;
  for i in $( find $PKG/opt/rocm/man -type l ) ; do
    ln -s $( readlink $i ).gz $i.gz ; rm $i
  done
fi

# Runtime integration pieces
mkdir -p $PKG/etc/ld.so.conf.d $PKG/etc/profile.d
cat $CWD/env/rocm.conf > $PKG/etc/ld.so.conf.d/rocm.conf.new
cat $CWD/env/rocm.sh   > $PKG/etc/profile.d/rocm.sh.new

# profile.d scripts are only sourced when executable (both /etc/profile
# and /etc/csh.login gate on -x). The generic 644 normalization pass
# above ran before this staging, so the bit survives untouched here.
chmod 755 $PKG/etc/profile.d/rocm.sh.new

# Program documentation (under the /usr/doc convention even though the
# payload lives in /opt/rocm, so pkgtool finds it where slackers expect)
PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cat $CWD/README > $PKGDOC/README
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

# ---------------------------------------------------------------------------
# Final payload contract check. Runs LAST, after everything it audits
# (payload, env files, doinst.sh) has been staged, so it gates the
# package right before makepkg instead of mid-assembly.
# ---------------------------------------------------------------------------
check_payload() {
  _miss=0
  for _must in \
    lib/libamdhip64.so.7 \
    lib/libhsa-runtime64.so.1 \
    lib/librccl.so.1 \
    bin/hipcc \
    bin/amd-smi \
    bin/rocminfo \
    lib/llvm/bin/clang \
    include/hip/hip_runtime.h
  do
    [ -e "$PKG/opt/rocm/$_must" ] || {
      echo "*** ERROR: staged /opt/rocm is missing $_must" >&2
      _miss=1
    }
  done

  # the files doinst.sh promises to resolve must be IN the package
  for _cfg in \
    install/doinst.sh \
    etc/ld.so.conf.d/rocm.conf.new \
    etc/profile.d/rocm.sh.new
  do
    [ -s "$PKG/$_cfg" ] || {   # -s: exists AND non-empty
      echo "*** ERROR: package is missing or has empty $_cfg" >&2
      _miss=1
    }
  done

  # every lib dir named in rocm.conf must exist in the payload
  while read -r _dir; do
    [ -d "$PKG$_dir" ] || {
      echo "*** ERROR: rocm.conf references $_dir but payload lacks it" >&2
      _miss=1
    }
  done < "$PKG/etc/ld.so.conf.d/rocm.conf.new"

  [ "$_miss" -eq 0 ] || { echo "*** ERROR: payload contract violated; aborting." >&2; exit 1; }
}
check_payload

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
